{
  "scripts": {
    "start": "npm-run-all --parallel css eleventy",
    "css": "postcss src/static/css/tailwind.css --o _site/css/style.css --watch",
    "eleventy": "eleventy --serve --port=8080",
    "build": "eleventy && npx @tailwindcss/cli -i src/static/css/tailwind.css -o _site/css/style.css",
    "algolia": "node ./scripts/algolia.js",
    "algolia:cd": "if [ \"$(git log -1 --pretty=format:'%an')\" != \"renovate[bot]\" ]; then npm run algolia; else echo 'Skipping Algolia update for renovate[bot] commit'; fi"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.8",
    "@playwright/test": "1.64.1",
    "@tailwindcss/cli": "4.3.4",
    "@tailwindcss/postcss": "4.3.4",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "26.6.6",
    "algolia-indexing": "2.0.0",
    "algoliasearch": "5.61.0",
    "alpinejs": "3.17.5",
    "flowbite": "4.0.2",
    "instantsearch.js": "4.122.0",
    "js-yaml": "5.5.0",
    "markdown-it-anchor": "9.2.1",
    "markdown-it-attrs": "5.0.1",
    "markdown-it-table-of-contents": "1.2.0",
    "npm-run-all2": "9.0.4",
    "postcss": "8.5.32",
    "postcss-cli": "12.0.0",
    "tailwindcss": "4.3.4"
  }
}
